.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(255, 240, 201);
}

.is-hidden {
    display: none;
}

.main-screen {
    background-color: rgba(10, 39, 70, 0.08);
}

.top-shade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 35%;
    background-color: rgba(18, 44, 73, 0.14);
}

.title-area {
    position: absolute;
    left: 18%;
    right: 18%;
    top: 7%;
    height: 180px;
    align-items: center;
}

.title-stack {
    width: 100%;
    height: 160px;
    align-items: center;
    justify-content: center;
}

.game-title {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 160px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/LilitaOne-Regular.ttf");
    -unity-text-align: middle-center;
    font-size: 130px;
    letter-spacing: 6px;
    white-space: nowrap;
}

.title-shadow {
    left: 7px;
    top: 10px;
    color: rgb(223, 125, 35);
}

.title-face {
    color: rgb(255, 235, 190);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(255, 248, 217, 0.85);
}

.menu-panel {
    position: absolute;
    left: 5.5%;
    top: 37%;
    width: 540px;
}

.menu-button,
.back-button,
.setting-button {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 7px;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/LilitaOne-Regular.ttf");
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    transition-property: scale, translate, background-color;
    transition-duration: 0.08s;
}

.menu-button {
    height: 114px;
    margin-bottom: 21px;
    font-size: 51px;
}

.primary-button {
    height: 153px;
    color: rgb(28, 55, 88);
    background-color: rgb(255, 191, 57);
    border-bottom-color: rgb(211, 111, 26);
    font-size: 77px;
}

.secondary-button {
    color: rgb(255, 239, 198);
    background-color: rgba(66, 99, 134, 0.96);
    border-bottom-color: rgba(31, 58, 87, 0.98);
}

.menu-button:hover,
.back-button:hover,
.setting-button:hover {
    scale: 1.025 1.025;
    translate: 0 -2px;
}

.menu-button:active,
.back-button:active,
.setting-button:active {
    scale: 0.98 0.98;
    translate: 0 3px;
}

.primary-button:hover {
    background-color: rgb(255, 207, 85);
}

.secondary-button:hover {
    background-color: rgb(79, 116, 154);
}

.menu-button:focus,
.back-button:focus,
.setting-button:focus {
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-left-color: rgb(255, 231, 167);
    border-right-color: rgb(255, 231, 167);
    border-top-color: rgb(255, 231, 167);
}

.modal-screen {
    align-items: center;
    background-color: rgba(10, 37, 65, 0.78);
}

.back-button {
    position: absolute;
    left: 4%;
    top: 5%;
    width: 210px;
    height: 66px;
    color: rgb(28, 55, 88);
    background-color: rgb(255, 204, 88);
    border-bottom-color: rgb(202, 112, 28);
    font-size: 32px;
}

.modal-heading {
    margin-top: 7%;
    align-items: center;
}

.screen-title {
    height: 100px;
    color: rgb(255, 235, 190);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/LilitaOne-Regular.ttf");
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(214, 112, 31);
    -unity-text-align: middle-center;
    font-size: 86px;
    letter-spacing: 7px;
}

.screen-subtitle {
    margin-top: -8px;
    color: rgb(255, 239, 197);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/PatrickHand-Regular.ttf");
    -unity-text-align: middle-center;
    font-size: 30px;
    letter-spacing: 4px;
}

.settings-card,
.credits-card {
    width: 720px;
    margin-top: 24px;
    padding: 22px 34px;
    background-color: rgba(246, 231, 191, 0.97);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 8px;
    border-left-color: rgb(222, 135, 50);
    border-right-color: rgb(222, 135, 50);
    border-top-color: rgb(222, 135, 50);
    border-bottom-color: rgb(170, 87, 35);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
}

.setting-row,
.credit-row {
    height: 76px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.setting-label,
.credit-name {
    color: rgb(31, 56, 84);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/LilitaOne-Regular.ttf");
    font-size: 33px;
    letter-spacing: 2px;
}

.volume-slider,
.setting-slider {
    width: 300px;
}

.volume-slider .unity-base-slider__tracker,
.setting-slider .unity-base-slider__tracker {
    height: 12px;
    background-color: rgb(70, 102, 136);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.volume-slider .unity-base-slider__dragger,
.setting-slider .unity-base-slider__dragger {
    width: 24px;
    height: 24px;
    background-color: rgb(255, 183, 51);
    border-left-color: rgb(211, 111, 26);
    border-right-color: rgb(211, 111, 26);
    border-top-color: rgb(211, 111, 26);
    border-bottom-color: rgb(211, 111, 26);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.fullscreen-toggle,
.setting-toggle {
    width: 62px;
    font-size: 27px;
}

.setting-button {
    width: 240px;
    height: 54px;
    color: rgb(255, 239, 198);
    background-color: rgb(66, 99, 134);
    border-bottom-color: rgb(35, 62, 91);
    font-size: 26px;
}

.setting-dropdown {
    width: 240px;
    height: 54px;
    color: rgb(255, 239, 198);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/LilitaOne-Regular.ttf");
    font-size: 25px;
}

.setting-dropdown .unity-base-field__input {
    height: 54px;
    padding-left: 18px;
    padding-right: 14px;
    color: rgb(255, 239, 198);
    background-color: rgb(66, 99, 134);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 6px;
    border-bottom-color: rgb(35, 62, 91);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}

.setting-dropdown .unity-base-popup-field__text {
    color: rgb(255, 239, 198);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.card-divider {
    height: 2px;
    background-color: rgba(171, 131, 78, 0.34);
}

.credit-role {
    color: rgb(69, 103, 139);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/PatrickHand-Regular.ttf");
    font-size: 27px;
}

.made-with {
    margin-top: 8px;
    color: rgb(255, 239, 190);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/LilitaOne-Regular.ttf");
    font-size: 22px;
    letter-spacing: 3px;
}

.technology-credit {
    margin-top: 14px;
    align-items: center;
}

.technology-heading {
    color: rgb(255, 226, 143);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/LilitaOne-Regular.ttf");
    -unity-text-align: middle-center;
    font-size: 21px;
    letter-spacing: 3px;
}

.technology-link {
    height: 34px;
    margin-top: 2px;
    padding-left: 14px;
    padding-right: 14px;
    color: rgb(255, 245, 210);
    background-color: rgba(31, 70, 107, 0.82);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgb(232, 143, 53);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/PatrickHand-Regular.ttf");
    font-size: 22px;
}

.main-screen.is-compact .title-area {
    left: 8%;
    right: 8%;
}

.main-screen.is-compact .game-title {
    font-size: 84px;
}

.main-screen.is-compact .menu-panel {
    left: 4%;
    width: 450px;
}

.modal-screen.is-compact .settings-card,
.modal-screen.is-compact .credits-card {
    width: 72%;
    min-width: 520px;
}
