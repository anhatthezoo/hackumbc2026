:root {
    --ink: rgb(255, 255, 255);
    --sail-blue: rgb(255, 255, 255);
    --sail-blue-hover: rgb(245, 245, 245);
    --rail: rgba(0, 0, 0, 0.56);
}

.build-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.build-vignette-edge {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.055);
}

.build-vignette-top,
.build-vignette-bottom {
    left: 0;
    right: 0;
    height: 92px;
}

.build-vignette-top {
    top: 0;
}

.build-vignette-bottom {
    bottom: 0;
}

.build-vignette-left,
.build-vignette-right {
    top: 0;
    bottom: 0;
    width: 92px;
}

.build-vignette-left {
    left: 0;
}

.build-vignette-right {
    right: 0;
}

.build-title {
    position: absolute;
    /* This aligns the rendered glyph edge with the 64px rail. */
    left: 62px;
    top: 78.5px;
    height: 86px;
    color: var(--ink);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DarumadropOne-Regular.ttf");
    -unity-text-align: upper-left;
    font-size: 64px;
    translate: 0 -43px;
    transition-duration: 0.34s;
    transition-timing-function: ease-out;
}

.build-title-shadow {
    left: 65px;
    top: 81.5px;
    color: rgba(0, 0, 0, 0.25);
}

.parts-rail {
    position: absolute;
    left: 64px;
    top: 216px;
    width: 160px;
    height: 800px;
    padding: 32px;
    background-color: var(--rail);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    overflow: hidden;
    transition-duration: 0.38s;
    transition-timing-function: ease-out;
}

.parts-rail .unity-scroller--horizontal,
.parts-rail .unity-scroller--vertical {
    display: none;
}

.parts-list {
    align-items: center;
}

.part-button {
    width: 96px;
    height: 96px;
    min-width: 96px;
    min-height: 96px;
    margin-bottom: 32px;
    padding: 0;
    background-color: rgba(255, 255, 255, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.part-button:hover {
    scale: 1.13 1.13;
    translate: 8px 0;
    background-color: rgba(255, 255, 255, 0.13);
}

.part-button:active {
    scale: 0.96 0.96;
    translate: 4px 2px;
    background-color: rgba(91, 162, 235, 0.28);
}

.part-thumbnail {
    width: 96px;
    height: 96px;
    -unity-background-scale-mode: scale-to-fit;
}

.part-button.is-entering {
    opacity: 0;
    translate: -22px 0;
    scale: 0.82 0.82;
}

.money-hud {
    position: absolute;
    right: 48px;
    top: 9px;
    width: 364px;
    height: 140px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    rotate: 5deg;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.coin-icon {
    width: 80px;
    height: 80px;
    margin-right: 16px;
    background-image: url("project://database/Assets/Textures/Icons/CoinIconWhite.png");
    -unity-background-scale-mode: scale-to-fit;
}

.money-text-stack {
    position: relative;
    height: 109px;
}

.money-text-stack.balance-width-one {
    width: 48px;
}

.money-text-stack.balance-width-short {
    width: 120px;
}

.money-text-stack.balance-width-medium {
    width: 220px;
}

.money-text-stack.balance-width-long {
    width: 260px;
}

.money-balance {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 109px;
    color: var(--ink);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DarumadropOne-Regular.ttf");
    -unity-text-align: middle-right;
    font-size: 64px;
}

.money-balance-shadow {
    left: auto;
    right: -3px;
    top: 3px;
    color: rgba(0, 0, 0, 0.25);
}

.sail-button {
    position: absolute;
    right: 64px;
    bottom: 64px;
    height: 104px;
    width: 291px;
    padding: 0;
    align-items: center;
    justify-content: center;
    color: rgb(0, 0, 0);
    background-color: var(--sail-blue);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 52px;
    border-top-right-radius: 52px;
    border-bottom-left-radius: 52px;
    border-bottom-right-radius: 52px;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.sail-button:hover {
    scale: 1.06 1.06;
    translate: 0 -6px;
    background-color: var(--sail-blue-hover);
}

.sail-button:active {
    scale: 0.96 0.96;
    translate: 0 2px;
    background-color: rgb(225, 225, 225);
}

.sail-button:disabled {
    opacity: 0.5;
}

.ship-summary {
    position: absolute;
    right: 64px;
    bottom: 246px;
    width: 291px;
    min-height: 68px;
    padding: 10px 20px;
    background-color: rgba(0, 0, 0, 0.56);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.ship-summary-label {
    height: 28px;
    color: var(--ink);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DarumadropOne-Regular.ttf");
    -unity-text-align: middle-left;
    font-size: 22px;
}

.flip-button {
    position: absolute;
    right: 64px;
    bottom: 174px;
    width: 291px;
    height: 58px;
    padding: 0;
    color: rgb(0, 0, 0);
    background-color: rgb(255, 255, 255);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 29px;
    border-top-right-radius: 29px;
    border-bottom-left-radius: 29px;
    border-bottom-right-radius: 29px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DarumadropOne-Regular.ttf");
    -unity-text-align: middle-center;
    font-size: 28px;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.flip-button:hover {
    background-color: rgb(235, 235, 235);
    scale: 1.03 1.03;
}

.flip-button:active {
    background-color: rgb(215, 215, 215);
    scale: 0.97 0.97;
}

.sail-icon {
    width: 72px;
    height: 72px;
    background-image: url("project://database/Assets/Textures/Icons/BoatIcon.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(0, 0, 0);
    scale: -1 1;
    margin-right: 10px;
}

.sail-label {
    width: 97px;
    height: 72px;
    color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DarumadropOne-Regular.ttf");
    -unity-text-align: middle-center;
    font-size: 48px;
}

.sail-content {
    width: 179px;
    height: 72px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.part-detail-card {
    position: absolute;
    left: 240px;
    top: 216px;
    width: 560px;
    padding: 16px;
    background-color: rgba(0, 0, 0, 0.55);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    opacity: 0;
    visibility: hidden;
    translate: -16px 0;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.part-detail-card.part-detail-visible {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
}

.part-detail-header {
    min-height: 96px;
    flex-direction: row;
    align-items: flex-end;
}

.detail-thumbnail {
    width: 96px;
    height: 96px;
    margin-right: 24px;
    -unity-background-scale-mode: scale-to-fit;
}

.detail-copy {
    flex-grow: 1;
    justify-content: flex-end;
}

.detail-name,
.detail-cost,
.detail-description,
.detail-feature {
    color: var(--ink);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DarumadropOne-Regular.ttf");
    font-size: 32px;
}

.detail-name {
    margin-bottom: -12px;
}

.detail-description {
    margin-top: 10px;
    padding-left: 24px;
    padding-right: 24px;
    white-space: normal;
}

.detail-features {
    margin-top: 8px;
    padding-left: 48px;
}

.detail-feature {
    height: 40px;
    white-space: normal;
}

.shop-status {
    position: absolute;
    left: 480px;
    right: 480px;
    bottom: 74px;
    min-height: 58px;
    padding: 12px 24px;
    display: none;
    color: var(--ink);
    background-color: rgba(0, 0, 0, 0.68);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DarumadropOne-Regular.ttf");
    -unity-text-align: middle-center;
    font-size: 24px;
    white-space: normal;
}

.shop-status-visible {
    display: flex;
}

.shop-status-error {
    background-color: rgba(143, 38, 27, 0.9);
}

.screen-enter {
    opacity: 0;
    translate: 0 -18px;
    scale: 0.96 0.96;
}
