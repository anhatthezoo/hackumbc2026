.ship-building-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: flex-end;
    justify-content: flex-end;
    padding-right: 42px;
    padding-bottom: 36px;
}

.ship-building-card {
    width: 360px;
    padding: 22px;
    background-color: rgba(19, 39, 54, 0.92);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(236, 208, 142);
    border-right-color: rgb(236, 208, 142);
    border-bottom-color: rgb(236, 208, 142);
    border-left-color: rgb(236, 208, 142);
}

.ship-building-title {
    color: rgb(244, 218, 154);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 7px;
}

.ship-building-hint {
    color: rgb(215, 225, 225);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 17px;
}

.set-sail-button {
    height: 58px;
    background-color: rgb(239, 203, 116);
    color: rgb(24, 39, 53);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    font-size: 24px;
    -unity-font-style: bold;
}

.set-sail-button:hover {
    background-color: rgb(255, 224, 145);
}

.set-sail-button:active {
    translate: 0 2px;
}
